# PostgreSQL（Docker / VM：填寫 DB 主機，通常為區網 IP，非容器內 localhost）
PG_HOST=192.168.1.199
PG_PORT=5432
PG_USER=vpp_reporting
PG_PASSWORD=your_password_here
PG_DATABASE=vpp

# vpp_realtime 資料表欄位名稱（佳里案場實際為 value / updated_at / sample_time）
PG_VALUE_COLUMN=value
PG_TIME_COLUMN=updated_at

# API listen（docker compose 會覆寫為 0.0.0.0:5000）
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
