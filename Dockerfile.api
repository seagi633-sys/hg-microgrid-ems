FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY backend-node ./backend-node

ENV FLASK_HOST=0.0.0.0
ENV FLASK_PORT=5000
# Optional local file; compose usually injects PG_* via environment
RUN mkdir -p backend

EXPOSE 5000

CMD ["node", "backend-node/server.mjs"]
